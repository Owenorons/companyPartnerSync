// GENERATED by scripts/pilot/render.py. Edit fixtures.json, then regenerate.
// Synthetic pilot data only. Run through scripts/pilot-seed.sh with an explicit org.
Boolean verifyOnly = false;
String phase = '__PHASE__';
Map<String, Schema.SObjectType> types = Schema.getGlobalDescribe();
String prefix = types.containsKey('psync__Partner_Application__c') ? 'psync__' : '';
List<Object> fixtures = (List<Object>) JSON.deserializeUntyped('__PAYLOAD__');
Map<String, Id> fixtureIds = new Map<String, Id>();
Integer created = 0;
Integer existingCount = 0;
String leadStatus = [SELECT MasterLabel FROM LeadStatus WHERE IsConverted = false ORDER BY SortOrder LIMIT 1].MasterLabel;
String opportunityStage = [SELECT MasterLabel FROM OpportunityStage WHERE IsActive = true AND IsClosed = false ORDER BY SortOrder LIMIT 1].MasterLabel;
for (Object item : fixtures) {
    Map<String, Object> fixture = (Map<String, Object>) item;
    String alias = (String) fixture.get('alias');
    String objectName = (String) fixture.get('object');
    if (objectName.endsWith('__c')) objectName = prefix + objectName;
    System.assert(types.containsKey(objectName), 'Missing pilot prerequisite object: ' + objectName);
    Map<String, Schema.SObjectField> fields = types.get(objectName).getDescribe().fields.getMap();
    String keyField = (String) fixture.get('keyField');
    if (keyField.endsWith('__c')) keyField = prefix + keyField;
    System.assert(fields.containsKey(keyField), 'Missing pilot identity field: ' + keyField);
    String fixtureKey = (String) fixture.get('key');
    List<SObject> matches = Database.query('SELECT Id FROM ' + objectName + ' WHERE ' + keyField + ' = :fixtureKey LIMIT 2');
    System.assert(matches.size() < 2, 'Ambiguous fixture identity: ' + alias);
    if (matches.isEmpty()) {
        System.assert(!verifyOnly && fixture.get('phase') == phase, 'Missing pilot fixture/prerequisite: ' + alias);
        SObject row = types.get(objectName).newSObject();
        Map<String, Object> values = (Map<String, Object>) fixture.get('fields');
        for (String field : values.keySet()) {
            String apiField = field.endsWith('__c') ? prefix + field : field;
            System.assert(fields.containsKey(apiField), 'Missing pilot field: ' + objectName + '.' + apiField);
            Object value = values.get(field);
            if (value instanceof Map<String, Object>) {
                Map<String, Object> token = (Map<String, Object>) value;
                if (token.containsKey('ref')) {
                    String refAlias = (String) token.get('ref');
                    System.assert(fixtureIds.containsKey(refAlias), 'Missing pilot reference: ' + refAlias);
                    value = fixtureIds.get(refAlias);
                } else if (token.containsKey('days')) {
                    value = Date.today().addDays(Integer.valueOf(String.valueOf(token.get('days'))));
                } else if (token.containsKey('hours')) {
                    value = System.now().addHours(Integer.valueOf(String.valueOf(token.get('hours'))));
                } else if (token.containsKey('user')) {
                    value = UserInfo.getUserId();
                } else if (token.containsKey('leadStatus')) {
                    value = leadStatus;
                } else if (token.containsKey('opportunityStage')) {
                    value = opportunityStage;
                }
            }
            row.put(apiField, value);
        }
        insert row;
        fixtureIds.put(alias, row.Id);
        created++;
    } else {
        // Preserve changes made by pilot testers; reruns create missing rows only.
        fixtureIds.put(alias, matches[0].Id);
        existingCount++;
    }
    System.debug(LoggingLevel.INFO, 'PILOT_FIXTURE ' + alias + '=' + fixtureIds.get(alias));
}
System.debug(LoggingLevel.INFO, 'PILOT_PHASE ' + phase + ' created=' + created + ' existing=' + existingCount + ' verifyOnly=' + verifyOnly);

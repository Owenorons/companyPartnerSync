<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Customer_Name_When_Submitted</fullName>
    <active>false</active>
    <errorConditionFormula
  >AND(ISPICKVAL(Status__c, &quot;Submitted&quot;), ISBLANK(Customer_Name__c))</errorConditionFormula>
    <errorDisplayField>Customer_Name__c</errorDisplayField>
    <errorMessage>Customer Name is required before submitting.</errorMessage>
</ValidationRule>

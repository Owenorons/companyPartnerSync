    >Deal_Event_Outbox__c</object>
    <viewAllFields>true</viewAllFields><viewAllRecords>true</viewAllRecords>
  </objectPermissions>
  <objectPermissions>
    <allowCreate>false</allowCreate><allowDelete>false</allowDelete>
    <allowEdit>false</allowEdit><allowRead>true</allowRead>
    <modifyAllRecords>false</modifyAllRecords><object

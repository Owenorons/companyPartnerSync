  <hasActivationRequired>false</hasActivationRequired>
  <customPermissions><enabled>true</enabled><name
    >PartnerSync_Replay_Deal_Event</name></customPermissions>
  <customPermissions><enabled>true</enabled><name
    >PartnerSync_View_Internal_Deal_Events</name></customPermissions>
  <customPermissions><enabled>true</enabled><name
    >PartnerSync_View_Event_Payload</name></customPermissions>
  <objectPermissions>
    <allowCreate>false</allowCreate><allowDelete>false</allowDelete>
    <allowEdit>false</allowEdit><allowRead>true</allowRead>

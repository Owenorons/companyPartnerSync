<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
  <label>PartnerSync Critical Conflict Authority</label>
  <description
  >Restricted authority to waive critical deal conflicts. Assign directly and sparingly; it is intentionally absent from persona groups.</description>
  <hasActivationRequired>false</hasActivationRequired>
  <customPermissions>
    <enabled>true</enabled>
    <name>PartnerSync_Waive_Critical_Conflict</name>
  </customPermissions>
  <classAccesses>
    <apexClass>DealConflictCommandController</apexClass>
    <enabled>true</enabled>
  </classAccesses>
  <objectPermissions>
    <allowCreate>false</allowCreate>
    <allowDelete>false</allowDelete>
    <allowEdit>false</allowEdit>
    <allowRead>true</allowRead>
    <modifyAllRecords>false</modifyAllRecords>
    <object>Deal_Conflict__c</object>
    <viewAllRecords>false</viewAllRecords>
  </objectPermissions>
</PermissionSet>

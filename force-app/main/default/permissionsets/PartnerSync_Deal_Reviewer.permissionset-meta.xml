<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>PartnerSync Deal Reviewer</label>
    <description
  >Standalone deal approval authority. Assign alongside PartnerSync_Executive_User (or any other role) to grant deal approve/reject/conflict-resolution rights without folding them into that role's base permission set.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <customPermissions>
        <enabled>true</enabled>
        <name>PartnerSync_Approve_Deal</name>
    </customPermissions>
    <customPermissions>
        <enabled>true</enabled>
        <name>PartnerSync_Reject_Deal</name>
    </customPermissions>
    <customPermissions>
        <enabled>true</enabled>
        <name>PartnerSync_Resolve_Deal_Conflict</name>
    </customPermissions>
    <classAccesses>
        <apexClass>DealReviewController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <fieldPermissions>
        <editable>true</editable>
        <field>Deal_Registration__c.Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Deal_Registration__c.Approval_Notes__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Deal_Registration__c.Rejection_Reason__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Deal_Registration__c.Decision_By__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Deal_Registration__c.Decision_On__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Deal_Registration__c.Protection_Start_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Deal_Registration__c.Protection_End_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Deal_Registration__c.Conflict_Status__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Deal_Registration__c.Conflict_Resolution_Notes__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <object>Deal_Registration__c</object>
        <viewAllFields>false</viewAllFields>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
</PermissionSet>

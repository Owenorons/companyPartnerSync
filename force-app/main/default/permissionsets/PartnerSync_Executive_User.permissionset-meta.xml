<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
      Read-only executive role. Deliberately grants ONLY the two
      executive-analytics custom permissions below. Do not add
      PartnerSync_Approve_Deal, PartnerSync_Reject_Deal,
      PartnerSync_Resolve_Deal_Conflict, PartnerSync_Approve_MDF,
      PartnerSync_Reject_MDF, or PartnerSync_Override_MDF_Budget here.
      An executive who also needs approval authority should be assigned
      PartnerSync_Deal_Reviewer and/or PartnerSync_MDF_Reviewer in
      addition to this permission set, not have approval rights folded
      into it.
    -->
    <customPermissions>
        <enabled>true</enabled>
        <name>PartnerSync_View_Executive_Analytics</name>
    </customPermissions>
    <customPermissions>
        <enabled>true</enabled>
        <name>PartnerSync_Export_Executive_Reports</name>

        "type": "Text",
        "length": 255
      },
      {
        "apiName": "Stage__c",
        "label": "Stage",
        "description": "Current sales stage for the registered deal.",
        "type": "Picklist",
        "values": [
          "Qualification",
          "Discovery",
          "Proposal",
          "Negotiation",
          "Closed Won",
          "Closed Lost"
        ]
      },
      {
        "apiName": "Status__c",
        "label": "Status",
        "description": "Approval and lifecycle status of the deal registration.",
        "type": "Picklist",
        "values": [
          "Draft",
          "Submitted",
          "Under Review",
          "Approved",
          "Rejected",
          "Expired",
          "Converted",
          "Closed Won",
          "Closed Lost"
        ]
      },
      {
        "apiName": "Conflict_Status__c",
        "label": "Conflict Status",
        "description": "Conflict review state for duplicate or competing deal registrations.",
        "type": "Picklist",
        "values": [
          "None",
          "Potential Conflict",
          "Confirmed Conflict",
          "Resolved"
        ]
      },
      {
        "apiName": "Submitted_Date__c",

        "referenceTo": "Account",
        "relationshipName": "Partner_Deal_Registrations"
      },
      {
        "apiName": "Deal_Registration_Number__c",
        "label": "Deal Registration Number",
        "description": "Auto-generated deal registration number for tracking and external display.",
        "type": "AutoNumber",
        "displayFormat": "DR-{000000}",
        "startingNumber": 1
      },
      {
        "apiName": "Submitted_By__c",
        "label": "Submitted By",
        "description": "Partner contact who submitted the deal registration.",
        "type": "Lookup",
        "referenceTo": "Contact",
        "relationshipName": "Submitted_Deal_Registrations"
      },
      {
        "apiName": "Customer_Account__c",
        "label": "Customer Account",
        "description": "Customer account associated with the registered deal.",
        "type": "Lookup",
        "referenceTo": "Account",
        "relationshipName": "Customer_Deal_Registrations"
      },
      {
        "apiName": "Opportunity__c",
        "label": "Opportunity",
        "description": "Opportunity created from or linked to this deal registration.",
        "type": "Lookup",
        "referenceTo": "Opportunity",
        "relationshipName": "Deal_Registrations"
      },
      {
        "apiName": "Source_Lead__c",
        "label": "Source Lead",

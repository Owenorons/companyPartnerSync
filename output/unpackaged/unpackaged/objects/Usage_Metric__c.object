    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>License_Tier__c</fullName>
        <externalId>false</externalId>
        <label>License Tier</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Metric_Date__c</fullName>
        <description>Usage date for the billable activity.</description>
        <label>Metric Date</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Metric_Type__c</fullName>
        <description>Type of billable partner activity being tracked.</description>
        <label>Metric Type</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>AI Request</fullName>
                    <default>false</default>
                    <label>AI Request</label>
                </value>
                <value>
                    <fullName>Deal Submitted</fullName>
                    <default>false</default>
                    <label>Deal Submitted</label>
                </value>
                <value>
                    <fullName>MDF Request</fullName>
                    <default>false</default>
                    <label>MDF Request</label>
                </value>
                <value>
                    <fullName>Lead Assigned</fullName>
                    <default>false</default>
                    <label>Lead Assigned</label>
                </value>
                <value>
                    <fullName>Content Download</fullName>
                    <default>false</default>
                    <label>Content Download</label>
                </value>
                <value>
                    <fullName>Notification Sent</fullName>
                    <default>false</default>
                    <label>Notification Sent</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Partner_Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Partner account this usage event is attributed to. Optional because Notification Sent events do not always resolve to a partner account.</description>
        <label>Partner Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipName>Usage_Metrics</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Quantity__c</fullName>
        <externalId>false</externalId>
        <label>Quantity</label>
        <precision>18</precision>
        <required>true</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Usage Metric</label>
    <nameField>
        <displayFormat>UM-{000000}</displayFormat>
        <label>Metric ID</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Usage Metrics</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>

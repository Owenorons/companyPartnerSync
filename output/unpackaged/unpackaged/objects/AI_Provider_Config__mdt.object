<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Whether this provider can be routed to. Only Disabled ships active by default.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Api_Version__c</fullName>
        <description>Provider API version, e.g. required for Azure OpenAI callouts.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Api Version</label>
        <length>50</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Base_URL__c</fullName>
        <description>Path appended to the Named Credential callout endpoint.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Base URL</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Max_Tokens__c</fullName>
        <description>Maximum response tokens requested from the provider.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Max Tokens</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Model_Name__c</fullName>
        <description>Model identifier to request from the provider.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Model Name</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Named_Credential__c</fullName>
        <description>Named Credential API name used for the callout endpoint and authentication.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Named Credential</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Provider_Name__c</fullName>
        <description>Display name for this provider.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Provider Name</label>
        <length>100</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Provider_Type__c</fullName>
        <description>Implementation type this record routes to.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Provider Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Disabled</fullName>
                    <default>false</default>
                    <label>Disabled</label>
                </value>
                <value>
                    <fullName>OpenAI</fullName>
                    <default>false</default>
                    <label>OpenAI</label>
                </value>
                <value>
                    <fullName>AzureOpenAI</fullName>
                    <default>false</default>
                    <label>AzureOpenAI</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Temperature__c</fullName>
        <description>Sampling temperature sent to the provider.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Temperature</label>
        <precision>3</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Timeout_Seconds__c</fullName>
        <description>Callout timeout in seconds.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Timeout Seconds</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>AI Provider Config</label>
    <pluralLabel>AI Provider Configs</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

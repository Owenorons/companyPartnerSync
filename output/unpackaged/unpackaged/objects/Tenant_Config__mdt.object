    <fields>
        <fullName>Edition__c</fullName>
        <description>Product edition for this tenant.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Edition</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Bronze</fullName>
                    <default>false</default>
                    <label>Bronze</label>
                </value>
                <value>
                    <fullName>Silver</fullName>
                    <default>false</default>
                    <label>Silver</label>
                </value>
                <value>
                    <fullName>Gold</fullName>
                    <default>false</default>
                    <label>Gold</label>
                </value>
                <value>
                    <fullName>Enterprise</fullName>
                    <default>false</default>
                    <label>Enterprise</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>

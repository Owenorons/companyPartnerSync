<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Indicates whether the webhook endpoint is active.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Endpoint_Name__c</fullName>
        <description>Business name of the webhook endpoint.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Endpoint Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Event_Filter__c</fullName>
        <description>Semicolon-separated list of events that trigger this webhook, or All.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Event Filter</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Retry_Count__c</fullName>
        <description>Number of retry attempts on delivery failure.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Retry Count</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Timeout_Seconds__c</fullName>
        <description>Callout timeout in seconds.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Timeout Seconds</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>URL__c</fullName>
        <description>Webhook endpoint URL.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>URL</label>
        <required>false</required>
        <type>Url</type>
    </fields>
    <label>Webhook Endpoint</label>
    <pluralLabel>Webhook Endpoints</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>

<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Indicates whether the badge rule is active.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Badge_Code__c</fullName>
        <description>Badge code awarded by the gamification rule.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Badge Code</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Badge_Name__c</fullName>
        <description>Badge name awarded by the gamification rule.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Badge Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Icon__c</fullName>
        <description>Icon representing this badge.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Icon</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Metric_Name__c</fullName>
        <description>Metric evaluated by the badge rule.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Metric Name</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Minimum_Score__c</fullName>
        <description>Minimum partner performance score required for this tier badge.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Minimum Score</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Operator__c</fullName>
        <description>Comparison operator used by the badge rule.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Operator</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Equals</fullName>
                    <default>false</default>
                    <label>Equals</label>
                </value>
                <value>
                    <fullName>Greater Than</fullName>
                    <default>false</default>
                    <label>Greater Than</label>
                </value>
                <value>
                    <fullName>Greater Or Equal</fullName>
                    <default>false</default>
                    <label>Greater Or Equal</label>
                </value>
                <value>
                    <fullName>Less Than</fullName>
                    <default>false</default>
                    <label>Less Than</label>
                </value>
                <value>
                    <fullName>Less Or Equal</fullName>
                    <default>false</default>
                    <label>Less Or Equal</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Threshold__c</fullName>
        <description>Threshold value required to earn the badge.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Threshold</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Badge Rule Config</label>
    <pluralLabel>Badge Rule Configs</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
